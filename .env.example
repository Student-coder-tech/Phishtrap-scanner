# This project now uses two separate env files:
#
#   server/.env.example  -> copy to server/.env  (PORT, MONGODB_URI, PYTHON_SERVICE_URL, NODE_ENV)
#
# The client does not require any secrets: it talks to the server only
# through relative /api/* calls, proxied by client/vite.config.ts in dev
# and served from the same origin in production.
