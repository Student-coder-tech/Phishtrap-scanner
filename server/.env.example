# PORT: Port the Express API server listens on.
PORT=3000

# NODE_ENV: Set to "production" to have the server also serve the
# built client (client/dist). Leave unset/"development" when running
# the client's own Vite dev server alongside this one.
NODE_ENV=development

# MONGODB_URI: Optional MongoDB connection string for enterprise persistent scan reports.
# When not set, PHISHTRAP uses its built-in transactional memory/local store.
MONGODB_URI=""

# PYTHON_SERVICE_URL: Optional URL for external Python FastAPI microservice (e.g., http://127.0.0.1:8000)
# When not configured or unreachable, the Node backend automatically uses the built-in multi-signal engine.
PYTHON_SERVICE_URL=""
